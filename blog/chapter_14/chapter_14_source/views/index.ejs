<!DOCTYPE html>
<html lang="en">

<%- include('layouts/header'); -%>

<body>

  <!-- Navigation -->
  <%- include('layouts/navbar'); -%>

  <!-- Page Header -->
  <header class="masthead" style="background-image: url('/img/home-bg.jpg')">
    <div class="overlay"></div>
    <div class="container">
      <div class="row">
        <div class="col-lg-8 col-md-10 mx-auto">
          <div class="site-heading">
            <h2 class="subheading">
              <% if (blogposts.length > 0) { %>
                <%= blogposts[0].body.substring(0, 100) %> ...
              <% } %>
            </h2>
            <span class="meta">
              Posted by
              <a href="#">
                <%= blogposts[0] && blogposts[0].userid ? blogposts[0].userid.username : "Unknown User" %>
              </a>
              on <%= blogposts[0] ? blogposts[0].datePosted.toDateString() : "" %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="container">
    <div class="row">
      <div class="col-lg-8 col-md-10 mx-auto">

        <% for (let i = 0; i < blogposts.length; i++) { %>
          <div class="post-preview">
            <a href="/post/<%= blogposts[i]._id %>">
              <h2 class="post-title">
                <%= blogposts[i].title %>
              </h2>
              <h3 class="post-subtitle">
                <%= blogposts[i].body.substring(0, 100) %>...
              </h3>
            </a>
            <p class="post-meta">
              Posted by
              <a href="#">
                <%= blogposts[i].userid ? blogposts[i].userid.username : "Unknown User" %>
              </a>
              on <%= blogposts[i].datePosted.toDateString() %>
            </p>
          </div>
          <hr>
        <% } %>

        <!-- Pager -->
        <div class="clearfix">
          <a class="btn btn-primary float-right" href="#">Older Posts &rarr;</a>
        </div>

      </div>
    </div>
  </div>

  <hr>

  <%- include('layouts/footer'); -%>
  <%- include('layouts/scripts'); -%>

</body>
</html>
